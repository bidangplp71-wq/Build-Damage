rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // SIM-PKBG PUPR FIREBASE SECURITY SHIELD & ANTI-RETAS ENGINE
    // Standard Keamanan Siber & Proteksi Tingkat Tinggi (RBAC Enforced)
    // Otoritas Tertinggi: Super Admin (Vancy Djogo - bidangplp71@gmail.com)
    // =========================================================================

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'bidangplp71@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'super_admin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin')
      );
    }

    function isVerifikator() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin_verifikator')
      );
    }

    function isSurveyorUser() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'admin_user' || getUserData().role == 'admin_verifikator'))
      );
    }

    function isPublicGuest() {
      return true; // Read-only access for verified public reports & general statistics
    }

    // Rate-limiting / anti-tamper payload validation helper
    function validAssessmentPayload() {
      return request.resource.data.buildingName is string &&
             request.resource.data.buildingName.size() > 0 &&
             request.resource.data.buildingName.size() <= 250 &&
             request.resource.data.totalFloorAreaM2 is number &&
             request.resource.data.totalFloorAreaM2 > 0 &&
             request.resource.data.totalDamagePercent is number &&
             request.resource.data.totalDamagePercent >= 0 &&
             request.resource.data.totalDamagePercent <= 100;
    }

    // -------------------------------------------------------------------------
    // 1. DATA PENILAIAN KERUSAKAN BANGUNAN GEDUNG (assessments)
    // -------------------------------------------------------------------------
    match /assessments/{assessmentId} {
      // Publik & Tamu: Hanya boleh membaca dokumen yang sudah diverifikasi atau baca publik
      allow read: if isPublicGuest();

      // Surveyor & Admin: Dapat membuat data penilaian baru
      allow create: if isSurveyorUser() && validAssessmentPayload();

      // Surveyor hanya dapat mengedit penilaian miliknya jika belum diverifikasi
      // Verifikator dapat memperbarui status verifikasi & rekomendasi teknis
      // Super Admin & Admin Utama memiliki akses penuh
      allow update: if isSuperAdmin() || isAdmin() || (
        isVerifikator()
      ) || (
        isSurveyorUser() && 
        resource.data.createdBy == request.auth.uid && 
        resource.data.verificationStatus != 'Terverifikasi' &&
        validAssessmentPayload()
      );

      // Penghapusan data: Hanya Super Admin dan Admin Utama
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. DATA MASTER KEPENDUDUKAN DUKCAPIL (dukcapil_records)
    // -------------------------------------------------------------------------
    match /dukcapil_records/{recordId} {
      // Data kependudukan terenkripsi hanya dapat dibaca oleh staf terdaftar (Non-publik)
      allow read: if isAuthenticated();

      // Penambahan / sinkronisasi data warga: Surveyor, Verifikator, Admin, Super Admin
      allow create, update: if isSurveyorUser() || isAdmin();

      // Penghapusan data warga master: Hanya Super Admin & Admin Utama
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. MASTER WILAYAH (kecamatan & desa pemekaran)
    // -------------------------------------------------------------------------
    match /kecamatan/{kecamatanId} {
      allow read: if isPublicGuest();
      allow write: if isAdmin();
    }

    match /desa/{desaId} {
      allow read: if isPublicGuest();
      allow write: if isAdmin() || isSurveyorUser(); // Memungkinkan surveyor mendaftarkan desa pemekaran baru
    }

    // -------------------------------------------------------------------------
    // 4. MANAJEMEN AKUN PENGGUNA & KUOTA HAK AKSES (users)
    // Super Admin: Max 1 (Vancy Djogo)
    // Admin: Max 3 | Verifikator: Max 15 | Surveyor: Max 100 | Publik: Max 10
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // User dapat membaca profilnya sendiri; Admin dapat membaca seluruh user
      allow read: if isAuthenticated();

      // Pembuatan/Pengubahan hak akses pengguna:
      // Hanya Super Admin yang berhak memodifikasi Super Admin & Admin Utama
      allow create, update: if isSuperAdmin() || (
        isAdmin() && request.resource.data.role != 'super_admin'
      );

      // Super Admin akun tidak dapat dihapus oleh siapa pun
      allow delete: if isSuperAdmin() && resource.data.email != 'bidangplp71@gmail.com';
    }

    // -------------------------------------------------------------------------
    // 5. KONFIGURASI SISTEM & GOOGLE SHEET INTEGRATION (system_configs)
    // -------------------------------------------------------------------------
    match /system_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. AUDIT LOG & CATATAN KEAMANAN FIREBASE (security_audit_logs)
    // -------------------------------------------------------------------------
    match /security_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Otomatis log aktivitas
      allow update, delete: if false;     // Immutability: Log tidak boleh diubah/dihapus
    }
  }
}
